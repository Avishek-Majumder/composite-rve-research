# Python cache and compiled files
__pycache__/
*.py[cod]
*$py.class

# Testing and analysis caches
.pytest_cache/
.mypy_cache/
.coverage
htmlcov/

# Jupyter temporary files
.ipynb_checkpoints/

# Local Python environments
.venv/
venv/
env/
ENV/

# Local environment variables and secrets
.env
.env.*
!.env.example

# Packaging artifacts
build/
dist/
*.egg-info/

# Operating-system files
.DS_Store
Thumbs.db

# Generated simulation meshes
meshes/*
!meshes/.gitkeep

# Generated simulation results
results/raw/*
!results/raw/.gitkeep
results/processed/*
!results/processed/.gitkeep

# Runtime logs
logs/*
!logs/.gitkeep

# Common finite-element output formats
*.xdmf
*.h5
*.hdf5
*.bp
*.msh
*.vtk
*.vtu
*.pvtu
*.pvd
